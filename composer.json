{
    "name": "tuxonice/state-machine-playground",
    "description": "Playground for experimenting with the tuxonice/state-machine library: order and lead workflows with CLI and web UI",
    "type": "project",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tuxonice/state-machine"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "tuxonice/state-machine": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "jbzoo/mermaid-php": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Tlab\\StatemachinePlayground\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tlab\\StatemachinePlayground\\Tests\\": "tests/"
        }
    }
}
